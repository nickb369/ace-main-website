    <script>
      const endpoint = 'https://acetailored.co.uk/acquisition/analytics/v1/event';
      const key = 'ace_phase1_measurement_v001';
      const status = document.querySelector('[data-ace-measurement-status]');
      const allow = document.querySelector('[data-ace-measurement-allow]');
      const decline = document.querySelector('[data-ace-measurement-decline]');
      const withdraw = document.querySelector('[data-ace-measurement-withdraw]');
      const links = [...document.querySelectorAll('a[href="https://acetailored.co.uk/acquisition/beauty-paid/"]')];
      const read = () => { try { return JSON.parse(sessionStorage.getItem(key) || 'null'); } catch { return null; } };
      const write = value => sessionStorage.setItem(key, JSON.stringify(value));
      const attribution = () => { const q = new URLSearchParams(location.search); return Object.fromEntries(['utm_source','utm_medium','utm_campaign','utm_content','utm_term','campaign_id'].map(k=>[k,q.get(k)]).filter(([,v])=>v)); };
      const decorate = state => links.forEach(link => { const u = new URL(link.href); if (state?.handoff_token) u.searchParams.set('ace_measurement',state.handoff_token); link.href = u.toString(); });
      const send = async (event_name, producer_record_id, extra={}) => {
        const current = read();
        const response = await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({consent:true,event_name,producer_record_id,landing_page:location.pathname,...attribution(),...current,...extra}),keepalive:event_name==='primary_cta_clicked'});
        if (!response.ok) throw new Error('MEASUREMENT_UNAVAILABLE');
        return response.json();
      };
      allow?.addEventListener('click',async()=>{ allow.disabled=true; decline.disabled=true; try { const data=await send('page_viewed',crypto.randomUUID()); const next={anonymous_analytics_id:data.anonymous_analytics_id,handoff_token:data.handoff_token}; write(next); decorate(next); withdraw.hidden=false; status.textContent='Optional measurement is on for this browser session.'; } catch { status.textContent='Optional measurement could not be enabled. You can continue without it.'; } finally { allow.disabled=false; decline.disabled=false; } });
      decline?.addEventListener('click',()=>{ sessionStorage.removeItem(key); decorate(null); withdraw.hidden=true; status.textContent='Optional measurement remains off.'; });
      withdraw?.addEventListener('click',async()=>{ const current=read(); try { if(current) await fetch(endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({event_name:'consent_withdrawn',anonymous_analytics_id:current.anonymous_analytics_id})}); sessionStorage.removeItem(key); decorate(null); withdraw.hidden=true; status.textContent='Optional measurement has been withdrawn and its optional journey deleted.'; } catch { status.textContent='We could not confirm withdrawal. Please try again or contact A.C.E.'; } });
      links.forEach(link=>link.addEventListener('click',()=>{ const current=read(); if(current) send('primary_cta_clicked',crypto.randomUUID()).catch(()=>{}); }));
      decorate(read());
    </script>
