 article:last-child{border:none}.pillar-grid h3{margin:20px 0 9px}.pillar-grid p{margin:0;color:var(--muted);font-size:.93rem}.process ol{margin:0;padding:0;list-style:none}.process li{display:grid;grid-template-columns:55px 1fr;gap:17px;padding:0 0 20px;margin-bottom:22px;border-bottom:1px solid var(--line)}.process li>b{display:grid;place-items:center;width:43px;height:43px;border:1px solid var(--copper);border-radius:50%;font-size:.72rem}.process h3{margin:0 0 5px;font-size:1.35rem}.process li p{margin:0;color:var(--muted);font-size:.9rem}.delivery{padding:0 0 clamp(75px,10vw,135px);background:var(--cream)}.delivery-in{display:grid;grid-template-columns:165px 1fr;gap:35px;align-items:center;padding:45px 55px;background:var(--dark);color:rgba(255,255,255,.85)}.delivery-in>strong{color:var(--light);font:600 clamp(6rem,11vw,8.5rem)/.8 'Playfair Display',serif;text-align:center}.delivery-in p:last-child{margin:0;font-size:1.08rem}.price-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:930px;margin:auto}.price-grid article{display:flex;flex-direction:column;padding:36px;background:rgba(255,255,255,.54);border:1px solid var(--line)}.price-grid .featured{background:var(--navy);border-color:var(--navy);color:rgba(255,255,255,.82);box-shadow:0 20px 38px rgba(16,42,63,.2)}.price-grid .featured .cap{color:var(--light)}.price-grid h3{margin:2px 0 13px;color:var(--navy);font-size:clamp(3.4rem,6vw,5.3rem)}.price-grid .featured h3{color:white}.price-grid h3 small{font-size:.45em}.price-grid h3 em{font:600 .95rem Montserrat,sans-serif;color:inherit}.price-grid hr{width:100%;margin:22px 0;border:0;border-top:1px solid currentColor;opacity:.16}.price-grid article>p:not(.cap){min-height:53px;font-size:.93rem}.price-grid .full{width:100%;margin-top:auto}.outline{background:transparent;color:var(--navy);border-color:var(--navy);box-shadow:none}.outline:hover{background:var(--navy);color:white}.faq{background:var(--paper)}.faq-list{max-width:850px;margin-top:43px}.fa