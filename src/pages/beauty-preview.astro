---
import AceLegalFooter from '../components/AceLegalFooter.astro';
const conceptUrl = 'https://tally.so/r/9qKAL4';
const pillars = [
  ['ATTRACT', 'Help the right people discover your beauty business and see the standard of your work.'],
  ['CONVERT', 'Give that attention a professional home where treatments, information and next steps are clear.'],
  ['ENGAGE', 'Help handle what happens around an enquiry, booking and a change in availability.'],
];
const concerns = [
  ['A client finds you on Instagram', 'They love your work, but still have to search for treatment information, prices, your location and how to book.'],
  ['A DM arrives while you are with a client', 'It waits. So does the next enquiry. You cannot give a treatment and answer every message at the same time.'],
  ['Tomorrow has a cancellation', 'There may be someone who would take it — but finding them and matching the right appointment is more manual work.'],
];
const websiteBenefits = [
  ['Show your work properly', 'A polished digital home that reflects the care you put into every treatment.'],
  ['Make the next step obvious', 'Clear treatment information, contact details and routes into your existing booking or enquiry process.'],
  ['Keep information in one place', 'Clients do not need to dig through months of posts for the basics.'],
  ['Stay focused on clients', 'A.C.E builds, hosts and manages the website so you do not have to become the technical person.'],
];
const faqs = [
  ['I already have Instagram. Why do I need a website?', 'Instagram is a brilliant place to show your work. Your website gives people a professional place to understand the business behind it, find the details they need and take the next step.'],
  ['I already use a booking system.', 'A.C.E can make the route into your existing supported booking process clearer on your website. Booking / Engage is a separate capability, introduced according to your business and the services it supports.'],
  ['Do I need to know anything about websites?', 'No. A.C.E guides the process, then handles hosting, security and ongoing website management after launch.'],
  ['Will you fill every cancellation?', 'No system can promise that. Booking / Engage is designed to create an opportunity: when availability changes, suitable customers already waiting may be offered the appointment.'],
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A.C.E Tailored creates and manages tailored websites for independent beauty businesses." />
    <meta name="robots" content="index, follow" />
    <title>A.C.E Tailored | Beauty preview V002</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <div class="wrap nav">
        <a class="brand" href="#top"><img src="/images/ace-tailored-logo.png" alt="A.C.E Tailored — Attract, Convert, Engage" /></a>
        <nav aria-label="Main navigation"><a href="#website">Website</a><a href="#engage">Booking / Engage</a><a href="#how">How it works</a><a href="#pricing">Pricing</a></nav>
        <a class="button small" href={conceptUrl}>Get my <strong class="free">FREE</strong>&nbsp;tailored website concept</a>
      </div>
    </header>
    <main id="main">
      <section class="hero" id="top">
        <div class="wrap hero-grid">
          <div>
            <p class="eyebrow light">FOR INDEPENDENT BEAUTY BUSINESSES</p>
            <h1>Spend less time chasing<br /><em>bookings, messages and cancellations.</em></h1>
            <p class="lead">More time doing the work you love. A.C.E gives your beauty business a beautiful online home that helps clients find the information and next step they need.</p>
            <div class="actions"><a class="button" href={conceptUrl}>Get your&nbsp;<strong class="free">FREE</strong>&nbsp;tailored website concept</a><a class="text-link" href="#difference">See how A.C.E works <span>→</span></a></div>
            <p class="fine">No payment. No obligation. See what your beautiful business could look like online.</p>
          </div>
          <div class="hero-visual" aria-label="Illustrative tailored beauty website shown on desktop and mobile">
            <div class="desktop"><div class="browser"><i></i><i></i><i></i></div><div class="site"><b>YOUR BEAUTY<br />BUSINESS</b><small>BEAUTY, YOUR WAY</small><strong>Your work,<br />beautifully presented.</strong><span>Explore treatments</span><div><i></i><i></i><i></i></div></div></div>
            <div class="phone"><b>YOUR BEAUTY<br />BUSINESS</b><small>WELCOME</small><strong>Made for the clients you want.</strong><span>View treatments</span></div>
            <div class="label"><b>✓</b><span><small>BUILT AROUND</small>Your business</span></div>
          </div>
        </div>
        <div class="strip"><span>TAILORED FOR BEAUTY</span><i></i><span>MANAGED FOR YOU</span><i></i><span>BUILT FOR MOBILE</span><i></i><span>CLEAR NEXT STEPS</span></div>
      </section>

      <section class="section recognition" id="difference">
        <div class="wrap">
          <div class="heading narrow"><p class="eyebrow">BECAUSE YOUR BUSINESS DOES NOT STOP BETWEEN APPOINTMENTS</p><h2>Your clients need your attention.<br /><em>Your systems should not.</em></h2><p>You may already be doing brilliant work and getting found through word of mouth, search and social media. But when information is scattered and every enquiry needs a manual answer, the digital side of the business can start competing with the client in front of you.</p></div>
          <div class="concerns">{concerns.map(([title, text], i) => <article><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
          <p class="centre statement">A.C.E is designed around the moments between discovery and appointment — so a potential client has a clearer, more professional journey while you are busy doing the work only you can do.</p>
        </div>
      </section>

      <section class="section split cream" id="website"><div class="wrap two">
        <div><p class="eyebrow">THE A.C.E WEBSITE</p><h2>Your work looks beautiful.<br /><em>Your website should too.</em></h2><p class="bodycopy">A.C.E gives your beauty business a professional digital home: somewhere that shows the standard of your work, makes treatment information easier to find and helps the right client feel confident taking the next step.</p><p class="bodycopy">It is not a generic do-it-yourself template. It is tailored around your business, then hosted, secured and managed by A.C.E after launch.</p><a class="text-link dark" href={conceptUrl}>Request your complimentary concept <span>→</span></a></div>
        <div class="benefits">{websiteBenefits.map(([title, text]) => <article><b>✦</b><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
      </div></section>

      <section class="section contrast"><div class="wrap"><p class="eyebrow light">THE EXPERIENCE YOUR CLIENTS FEEL</p><h2>From scattered information<br /><em>to a clearer path forward.</em></h2><div class="compare"><article><p class="cap">WITHOUT A CLEAR DIGITAL HOME</p><ul><li>Information spread across posts and messages</li><li>Repeated questions about treatments and booking</li><li>Enquiries waiting while you are with clients</li><li>A business that may not look as polished online as it is in person</li></ul></article><article class="after"><p class="cap">WITH A.C.E</p><ul><li>A professional website shaped around your business</li><li>Clear information and next steps for clients</li><li>A more organised path from interest to enquiry or booking</li><li>Ongoing website management, handled for you</li></ul></article></div></div></section>

      <section class="section engage" id="engage"><div class="wrap two engage-grid">
        <div><p class="eyebrow">A.C.E BOOKING / ENGAGE</p><h2>Support around the appointment.<br /><em>Not another system for you to manage.</em></h2><p class="bodycopy">Booking / Engage is an A.C.E capability being introduced for beauty businesses. It is designed to help with the moments that create repetitive admin: answering treatment enquiries, helping clients find the right next step, checking availability and capturing demand when the diary is full.</p><p class="notice">Booking / Engage is separate from the website managed service. Its final commercial package and price are not yet announced.</p></div>
        <div class="engage-card"><p class="cap">WHAT IT CAN HELP WITH</p><ul><li>Guide treatment enquiries toward the appropriate next step</li><li>Help reduce back-and-forth about appointment availability</li><li>Capture details from clients who want an appointment</li><li>Maintain a waiting list where that is appropriate for the business</li><li>Work around your business’s treatments, opening hours and individual setup</li></ul><p>It is designed to feel like support for your business — not a generic chatbot.</p></div>
      </div></section>

      <section class="recovery"><div class="wrap recovery-grid"><div class="circle">↗</div><div><p class="eyebrow light">WHEN AVAILABILITY CHANGES</p><h2>Cancellations happen.<br /><em>Empty appointments do not always have to.</em></h2><p>When an appointment is cancelled, Booking / Engage can identify suitable customers already waiting for an appointment and create an opportunity to offer the newly available slot.</p><p class="fine">That does not guarantee the slot will be filled. It gives the business a more organised chance to recover time that might otherwise remain empty.</p></div></div></section>

      <section class="section pillars"><div class="wrap"><div class="heading narrow"><p class="eyebrow">THE A.C.E SYSTEM</p><h2>Attract. Convert. Engage.</h2><p>A.C.E is a managed digital foundation for the business behind the treatments.</p></div><div class="pillar-grid">{pillars.map(([title, text], i) => <article><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

      <section class="section process cream" id="how"><div class="wrap two"><div><p class="eyebrow">SIMPLE FROM START TO FINISH</p><h2>See the direction<br /><em>before you decide.</em></h2><p class="bodycopy">The complimentary concept is the low-pressure first step. It is not a complete free website; it is a personalised direction for your business, so you can decide whether A.C.E feels right.</p><a class="button" href={conceptUrl}>Get my <strong class="free">FREE</strong>&nbsp;tailored website concept</a></div><ol><li><b>01</b><div><h3>Tell us about your beauty business</h3><p>Share a little about your services and where clients currently find you.</p></div></li><li><b>02</b><div><h3>See your personalised concept</h3><p>Review a tailored direction before making any decision to continue.</p></div></li><li><b>03</b><div><h3>Give us what we need</h3><p>If you continue, A.C.E gathers the required content, information and access through guided onboarding.</p></div></li><li><b>04</b><div><h3>Review your completed website</h3><p>Your new website is ready for review within 7 days once A.C.E has everything required.</p></div></li></ol></div></section>

      <section class="delivery"><div class="wrap delivery-in"><strong>7</strong><div><p class="eyebrow light">OUR DELIVERY PROMISE</p><p>Your new website, ready for review within <b>7 days</b> — once we have received all required information, content and access.</p></div></div></section>

      <section class="section pricing cream" id="pricing"><div class="wrap"><div class="heading centre"><p class="eyebrow">CLEAR WEBSITE PRICING</p><h2>Choose the route that<br /><em>works for your business.</em></h2><p>Booking / Engage is separate and is not included in the website managed service.</p></div><div class="price-grid"><article class="featured"><p class="cap">SPREAD THE COST</p><h3><small>£</small>72.25 <em>/ month</em></h3><p>For the first 12 months, then £39/month.</p><hr /><p>Includes website creation spread across 12 months, plus £39/month for hosting and ongoing website management.</p><a class="button full" href={conceptUrl}>Get my <strong class="free">FREE</strong>&nbsp;tailored website concept</a></article><article><p class="cap">PAY CREATION UPFRONT</p><h3><small>£</small>399 <em>upfront</em></h3><p>For website creation.</p><hr /><p>Then £39/month for hosting, security and ongoing website management.</p><a class="button outline full" href={conceptUrl}>Get my <strong class="free">FREE</strong>&nbsp;tailored website concept</a></article></div></div></section>

      <section class="section faq"><div class="wrap"><div class="heading narrow"><p class="eyebrow">QUESTIONS BEAUTY OWNERS OFTEN ASK</p><h2>Clear answers.<br /><em>No technical pressure.</em></h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></div></section>

      <section class="final"><div class="wrap"><p class="eyebrow light">YOUR BUSINESS · YOUR CONCEPT</p><h2>See what your beauty business<br /><em>could look like online.</em></h2><p>No payment. No obligation.</p><a class="button" href={conceptUrl}>Get my <strong class="free">FREE</strong>&nbsp;tailored website concept</a></div></section>
    </main>
    <footer><div class="wrap footer"><img src="/images/ace-tailored-logo.png" alt="A.C.E Tailored" /><p>We create and manage tailored websites for independent beauty businesses.</p><p>ATTRACT <i></i> CONVERT <i></i> ENGAGE</p></div><AceLegalFooter /></footer>
  </body>
</html>

<style is:global>
  :root{--cream:#f7f1e8;--paper:#fffaf4;--navy:#102a3f;--navy2:#17374f;--dark:#0d2639;--copper:#c77d57;--light:#d9946d;--muted:#5f6d78;--line:#d9d1c7}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--navy);background:var(--paper);font:400 16px/1.65 Montserrat,Arial,sans-serif}.wrap{width:min(1150px,calc(100% - 40px));margin:auto}.skip{position:absolute;left:-999px}.skip:focus{left:16px;top:16px;z-index:20;padding:10px;background:white}header{position:sticky;z-index:10;top:0;background:rgba(255,250,244,.96);border-bottom:1px solid rgba(16,42,63,.1);backdrop-filter:blur(12px)}.nav{min-height:84px;display:flex;align-items:center;gap:28px}.brand img{width:142px;height:auto;display:block}.nav nav{display:flex;gap:24px;margin-left:auto}.nav a{color:var(--navy);font-size:.78rem;font-weight:700;letter-spacing:.045em;text-decoration:none}.button{display:inline-flex;align-items:center;justify-content:center;min-height:55px;padding:13px 22px;border:1px solid var(--copper);background:var(--copper);color:var(--dark);font-size:.76rem;font-weight:700;letter-spacing:.045em;text-align:center;text-decoration:none;text-transform:uppercase;box-shadow:0 10px 24px rgba(12,38,57,.14)}.button:hover{background:var(--light);border-color:var(--light)}.button.small{min-height:42px;padding:10px 14px;font-size:.64rem}.eyebrow,.cap{margin:0 0 14px;color:var(--copper);font-size:.67rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.eyebrow.light{color:var(--light)}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:600;line-height:1.08}h1{margin-bottom:22px;color:white;font-size:clamp(3.1rem,6.6vw,5.9rem);letter-spacing:-.045em}h2{font-size:clamp(2.35rem,4.1vw,4.25rem);letter-spacing:-.04em}h3{font-size:1.45rem}em{color:var(--copper);font-style:normal}.hero{overflow:hidden;position:relative;padding:100px 0 0;background:linear-gradient(125deg,var(--dark),var(--navy2));color:white}.hero:before{content:'';position:absolute;right:-220px;top:-220px;width:700px;height:700px;border:1px solid rgba(217,148,109,.22);border-radius:50%}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.05fr .95fr;gap:45px;align-items:center;min-height:580px}.lead{max-width:630px;margin-bottom:30px;color:rgba(255,255,255,.82);font-size:clamp(1.05rem,1.7vw,1.23rem);line-height:1.75}.actions{display:flex;align-items:center;gap:26px;flex-wrap:wrap}.text-link{color:var(--cream);font-weight:700;text-decoration:none}.text-link span{margin-left:8px;color:var(--light)}.text-link.dark{color:var(--navy);display:inline-block;margin-top:14px}.fine{margin:18px 0 0;color:rgba(247,241,232,.72);font-size:.78rem}.hero-visual{position:relative;min-height:455px}.desktop{position:absolute;left:0;top:20px;width:88%;padding:10px;background:#fffdf9;box-shadow:0 30px 60px rgba(0,0,0,.3);transform:rotate(-2deg)}.browser{display:flex;gap:5px;padding:1px 0 9px}.browser i{width:6px;height:6px;border-radius:50%;background:#b9c3c9}.site{min-height:315px;padding:30px 38px;background:linear-gradient(135deg,#f0dbca 0 52%,#dca27e 52%);color:var(--navy)}.site>b,.phone>b{display:block;font:700 .6rem/1.1 Montserrat,sans-serif;letter-spacing:.1em}.site small,.phone small{display:block;margin-top:64px;color:#70442e;font:700 .62rem Montserrat,sans-serif;letter-spacing:.13em}.site strong{display:block;margin-top:12px;font:600 clamp(1.8rem,3vw,2.6rem)/1.02 'Playfair Display',serif}.site>span,.phone>span{display:inline-block;margin-top:21px;padding:9px 12px;background:var(--navy);color:white;font-size:.58rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.site>div{display:flex;gap:10px;margin-top:29px}.site>div i{flex:1;height:52px;background:rgba(255,255,255,.66)}.phone{position:absolute;right:0;bottom:6px;z-index:2;width:170px;height:340px;padding:35px 19px;border:7px solid #fffdf9;border-radius:28px;background:linear-gradient(155deg,#fff8ef 0 35%,#d89a78 35%);color:var(--navy);box-shadow:0 22px 40px rgba(0,0,0,.35);transform:rotate(5deg)}.phone small{margin-top:86px;font-size:.47rem}.phone strong{display:block;margin-top:10px;font:600 1.15rem/1.06 'Playfair Display',serif}.phone>span{font-size:.43rem}.label{position:absolute;z-index:3;bottom:12px;left:-12px;display:flex;gap:11px;align-items:center;padding:11px 15px;background:var(--cream);color:var(--navy);box-shadow:0 12px 26px rgba(0,0,0,.22)}.label b{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:var(--copper);color:white}.label small{display:block;color:var(--muted);font-size:.5rem;font-weight:700;letter-spacing:.1em}.label span{font:600 .9rem 'Playfair Display',serif}.strip{position:relative;z-index:1;display:flex;justify-content:center;align-items:center;gap:22px;min-height:62px;background:rgba(0,0,0,.17);color:#f6e4d6;font-size:.67rem;font-weight:700;letter-spacing:.11em}.strip i{width:5px;height:5px;background:var(--copper);transform:rotate(45deg)}.section{padding:clamp(75px,10vw,135px) 0}.heading.narrow{max-width:800px}.heading p:last-child{max-width:740px;color:var(--muted);font-size:1.05rem}.heading.centre{text-align:center;margin:0 auto 46px}.heading.centre p:last-child{margin:auto}.recognition{background:var(--paper)}.concerns{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:50px}.concerns article{min-height:240px;padding:30px;background:white;border:1px solid rgba(16,42,63,.1)}.concerns span,.pillar-grid span{color:var(--copper);font-size:.72rem;font-weight:700;letter-spacing:.14em}.concerns h3{margin:30px 0 10px}.concerns p{color:var(--muted);font-size:.92rem}.statement{max-width:760px;margin:43px auto 0;font:500 clamp(1.35rem,2.3vw,1.9rem)/1.35 'Playfair Display',serif}.centre{text-align:center}.cream{background:var(--cream)}.two{display:grid;grid-template-columns:1fr 1fr;gap:clamp(42px,8vw,105px);align-items:start}.bodycopy{max-width:570px;color:var(--muted);font-size:1.04rem}.benefits{display:grid;gap:16px}.benefits article{display:grid;grid-tem