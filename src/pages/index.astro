---
import WaxLadyLayout from "../layouts/WaxLadyLayout.astro";
import { site } from "../data/wax-lady-test";
---
<WaxLadyLayout title="Wax Lady | Waxing & massage in Stowmarket" active="/">
  <section class="hero">
    <div>
      <span class="eyebrow">Private. Personal. Professional.</span>
      <h1>Waxing that feels comfortable from the start.</h1>
      <p class="lead">Professional waxing and massage appointments from a private treatment room in Stowmarket, with friendly one-to-one care and no rush.</p>
      <div class="hero-actions">
        <a class="button" href={site.bookingUrl} rel="nofollow">Book an appointment</a>
        <a class="button button-secondary" href="/treatments">View treatments & prices</a>
      </div>
    </div>
    <div class="soft-panel" aria-label="A calm, welcoming visual panel">
      <div class="panel-note">
        <strong>First time?</strong>
        <span>If you're nervous or unsure which treatment to choose, you're welcome to ask before booking.</span>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Trust points">
    {site.trust.map((item) => <div>{item}</div>)}
  </section>

  <section class="section alt">
    <div class="section-grid">
      <div>
        <span class="eyebrow">Treatments</span>
        <h2>Clear choices, simple prices.</h2>
        <p>Waxing and massage treatments with prices shown upfront, so you know what to expect before you book.</p>
        <a class="button button-secondary" href="/treatments">See the full price list</a>
      </div>
      <div class="cards">
        <article class="card"><h3>Intimate waxing</h3><p>Discreet, professional appointments designed to feel straightforward and comfortable.</p></article>
        <article class="card"><h3>Body waxing</h3><p>From underarm and leg waxing to back or chest treatments.</p></article>
        <article class="card"><h3>Facial waxing</h3><p>Simple eyebrow, lip and chin waxing with clear pricing.</p></article>
        <article class="card"><h3>Massage</h3><p>30- and 60-minute massage appointments in the same private setting.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="two-col">
      <div class="quote-panel">
        <span class="eyebrow">The experience</span>
        <blockquote>“Welcoming, relaxed and reassuring — never judged or rushed.”</blockquote>
      </div>
      <div>
        <span class="eyebrow">Owner-led care</span>
        <h2>The same person, every visit.</h2>
        <p>Wax Lady is an owner-led business built around privacy, trust and personal one-to-one service. The aim is simple: make treatments that can feel intimidating feel completely normal.</p>
        <p>Appointments are by advance booking only from a private treatment room in Stowmarket.</p>
        <a class="button button-secondary" href="/about">About Wax Lady</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-grid">
      <div>
        <span class="eyebrow">Before you book</span>
        <h2>New to waxing? Start here.</h2>
        <p>Questions about preparation, discomfort, treatment differences and aftercare are normal. The FAQ page covers the things new clients most often want to know.</p>
      </div>
      <div class="cards">
        <article class="card"><h3>Preparation</h3><p>How to get ready before your appointment.</p></article>
        <article class="card"><h3>What to expect</h3><p>A clear, discreet explanation of how appointments work.</p></article>
        <article class="card"><h3>Aftercare</h3><p>What to avoid after waxing and how to look after your skin.</p></article>
        <article class="card"><h3>Still unsure?</h3><p>Call before booking if you're not sure which treatment is right for you.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="quote-panel">
      <span class="eyebrow">Ready when you are</span>
      <blockquote>Professional, discreet waxing in a relaxed, friendly environment.</blockquote>
      <div class="hero-actions">
        <a class="button" href={site.bookingUrl} rel="nofollow">Book an appointment</a>
        <a class="button button-secondary" href={site.phoneHref}>Call {site.phoneDisplay}</a>
      </div>
    </div>
  </section>
</WaxLadyLayout>