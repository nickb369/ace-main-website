---
const conceptUrl = "https://tally.so/r/9qKAL4";

const benefits = [
  {
    number: "01",
    title: "Tailored to your business",
    text: "A professionally built website shaped around your business, services and customers—not a generic do-it-yourself template.",
  },
  {
    number: "02",
    title: "See it before you commit",
    text: "Receive a complimentary personalised concept first, so you can see the direction before deciding whether to continue.",
  },
  {
    number: "03",
    title: "Managed for you",
    text: "Hosting, security and ongoing website management are handled by A.C.E, leaving you free to run your business.",
  },
  {
    number: "04",
    title: "Designed for mobile",
    text: "A responsive experience that presents your business clearly across phones, tablets and desktop screens.",
  },
  {
    number: "05",
    title: "Built to be found",
    text: "Clear page structure and practical SEO foundations help search engines understand your website.",
  },
  {
    number: "06",
    title: "Clear routes to act",
    text: "Focused calls to action support enquiries and existing booking paths, while visitor, enquiry and contact tracking shows what is working.",
  },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A.C.E creates and manages tailored websites for independent businesses. Request your complimentary personalised website concept."
    />
    <meta name="theme-color" content="#102a3f" />
    <title>A.C.E Tailored | Managed websites for independent businesses</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label="A.C.E Tailored home">
          <span class="brand-name">A.C.E</span>
          <span class="brand-rule"></span>
          <span class="brand-sub">TAILORED</span>
        </a>

        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#included">What’s included</a>
          <a href="#process">How it works</a>
          <a href="#pricing">Pricing</a>
        </nav>

        <a class="button button-small header-cta" href={conceptUrl}>
          Get My Complimentary Website Concept
        </a>

        <details class="mobile-menu">
          <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">
            <a href="#included">What’s included</a>
            <a href="#process">How it works</a>
            <a href="#pricing">Pricing</a>
            <a class="button button-small" href={conceptUrl}>Get My Complimentary Website Concept</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="hero-glow"></div>
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow light">ATTRACT <i></i> CONVERT <i></i> ENGAGE</p>
            <h1>See what your business could look like online—<em>before you commit.</em></h1>
            <p class="hero-intro">
              We create and manage tailored websites for independent businesses. Request your complimentary
              website concept, then decide whether you want us to build the real thing.
            </p>
            <p class="hero-price">
              Your tailored website from <strong>£72.25 per month</strong> for the first 12 months, then £39 per month.
            </p>
            <div class="hero-actions">
              <a class="button" href={conceptUrl}>Get My Complimentary Website Concept</a>
              <a class="text-link" href="#included">See What’s Included <span aria-hidden="true">→</span></a>
            </div>
            <p class="reassurance"><span aria-hidden="true">✓</span> Complimentary concept · No obligation</p>
          </div>

          <div class="showcase" aria-label="Example of a tailored website displayed on desktop and mobile">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="browser-card">
              <div class="browser-bar"><span></span><span></span><span></span></div>
              <div class="sample-site">
                <div class="sample-nav">
                  <div class="sample-mark">YOUR<br /><b>BUSINESS</b></div>
                  <div class="sample-links"><i></i><i></i><i></i></div>
                </div>
                <div class="sample-hero">
                  <p>WELCOME</p>
                  <h2>Your business,<br />beautifully presented.</h2>
                  <span>Discover our services</span>
                </div>
                <div class="sample-cards"><i></i><i></i><i></i></div>
              </div>
            </div>
            <div class="phone-card">
              <div class="phone-speaker"></div>
              <div class="phone-screen">
                <div class="phone-mark">YOUR<br /><b>BUSINESS</b></div>
                <p>WELCOME</p>
                <h3>Made for<br />your customers.</h3>
                <span>View services</span>
              </div>
            </div>
            <div class="proof-card">
              <span class="proof-icon" aria-hidden="true">✓</span>
              <span><small>CREATED FOR</small>Your business</span>
            </div>
          </div>
        </div>
        <div class="hero-ribbon">
          <div class="shell ribbon-inner">
            <span>TAILORED DESIGN</span><i></i><span>MANAGED FOR YOU</span><i></i><span>MOBILE FRIENDLY</span><i></i><span>SEO FOUNDATIONS</span>
          </div>
        </div>
      </section>

      <section class="section intro-section" id="included">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <p class="eyebrow">A BETTER WAY TO GET ONLINE</p>
              <h2>A professional website.<br /><em>Without the technical burden.</em></h2>
            </div>
            <p>
              You shouldn’t need to become a designer, developer or hosting expert to give your business a
              strong online presence. A.C.E handles the website while you handle the business.
            </p>
          </div>

          <div class="benefit-grid">
            {benefits.map((benefit) => (
              <article class="benefit-card">
                <span class="benefit-number">{benefit.number}</span>
                <div class="benefit-icon" aria-hidden="true"><span></span></div>
                <h3>{benefit.title}</h3>
                <p>{benefit.text}</p>
              </article>
            ))}
          </div>

          <div class="concept-band">
            <div>
              <p class="eyebrow light">YOUR COMPLIMENTARY CONCEPT</p>
              <h2>See what your business could look like online.</h2>
            </div>
            <a class="button" href={conceptUrl}>Get My Complimentary Website Concept</a>
          </div>
        </div>
      </section>

      <section class="section process-section" id="process">
        <div class="shell process-grid">
          <div class="process-copy">
            <p class="eyebrow">SIMPLE FROM START TO FINISH</p>
            <h2>From first idea to<br /><em>ready for review.</em></h2>
            <p>
              A clear, guided process gives you confidence at every stage—starting with a complimentary concept
              created around your business.
            </p>
          </div>
          <ol class="steps">
            <li><span>01</span><div><h3>Request your concept</h3><p>Tell us a little about your business and where customers can currently find you.</p></div></li>
            <li><span>02</span><div><h3>See the direction</h3><p>Review your complimentary personalised concept with no obligation to proceed.</p></div></li>
            <li><span>03</span><div><h3>Give us what we need</h3><p>If you continue, provide the required information, content and access through our guided onboarding.</p></div></li>
            <li><span>04</span><div><h3>Review the real website</h3><p>We build the completed version, ready for your review before launch.</p></div></li>
          </ol>
        </div>
      </section>

      <section class="delivery-section">
        <div class="shell delivery-card">
          <div class="seven">7</div>
          <div>
            <p class="eyebrow light">OUR DELIVERY PROMISE</p>
            <h2>Ready for review within<br /><em>seven working days.</em></h2>
          </div>
          <p>
            Once we have received all required information, content and access, your completed website will be
            ready for review within seven working days.
          </p>
        </div>
      </section>

      <section class="section pricing-section" id="pricing">
        <div class="shell">
          <div class="section-heading centred">
            <p class="eyebrow">CLEAR, STRAIGHTFORWARD PRICING</p>
            <h2>Choose the way that<br /><em>works for your business.</em></h2>
          </div>

          <div class="pricing-grid">
            <article class="price-card recommended">
              <p class="price-label">RECOMMENDED: SPREAD THE COST</p>
              <div class="price"><span>£</span><strong>72.25</strong><small>/ month</small></div>
              <p class="price-term">for the first 12 months, then £39 per month</p>
              <div class="price-rule"></div>
              <p>
                Includes the £399 website-creation cost split into 12 monthly instalments, plus £39 per month for
                hosting and management.
              </p>
              <p class="price-reassurance"><span>✓</span> No large upfront payment.</p>
              <a class="button full" href={conceptUrl}>Get My Complimentary Website Concept</a>
            </article>

            <article class="price-card upfront">
              <p class="price-label">PAY WEBSITE CREATION UPFRONT</p>
              <div class="price"><span>£</span><strong>399</strong><small> upfront</small></div>
              <p class="price-term">for website creation</p>
              <div class="price-rule"></div>
              <p>Pay the website-creation cost upfront, plus £39 per month for hosting and management.</p>
              <p class="price-reassurance"><span>✓</span> The same managed service.</p>
              <a class="button button-outline full" href={conceptUrl}>Get My Complimentary Website Concept</a>
            </article>
          </div>
          <p class="pricing-note">Both options include hosting, security and ongoing website management.</p>
        </div>
      </section>

      <section class="final-cta">
        <div class="final-orbit"></div>
        <div class="shell final-inner">
          <p class="eyebrow light">YOUR BUSINESS · YOUR CONCEPT</p>
          <h2>Ready to see what your business<br /><em>could look like online?</em></h2>
          <a class="button" href={conceptUrl}>Get My Complimentary Website Concept</a>
          <p>Your personalised concept is complimentary and carries no obligation.</p>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <a class="brand footer-brand" href="#top" aria-label="A.C.E Tailored home">
          <span class="brand-name">A.C.E</span><span class="brand-rule"></span><span class="brand-sub">TAILORED</span>
        </a>
        <p>We create and manage tailored websites for independent businesses.</p>
        <p class="footer-tag">ATTRACT <i></i> CONVERT <i></i> ENGAGE</p>
      </div>
    </footer>

    <a class="mobile-sticky" href={conceptUrl}>Get My Complimentary Website Concept</a>
  </body>
</html>

<style is:global>
  :root {
    --cream: #f7f1e8;
    --cream-deep: #eee4d7;
    --navy: #102a3f;
    --navy-2: #17374f;
    --navy-dark: #0d2639;
    --copper: #c77d57;
    --copper-light: #d9946d;
    --white: #fffdf9;
    --ink: #183247;
    --muted: #60707b;
    --line: rgba(16, 42, 63, 0.13);
    --shadow: 0 24px 70px rgba(11, 35, 53, 0.14);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    color: var(--ink);
    background: var(--cream);
    font-family: "Montserrat", system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { font-family: "Playfair Display", Georgia, serif; color: var(--navy); line-height: 1.08; }
  h1 { font-size: clamp(2.9rem, 5.8vw, 5.7rem); letter-spacing: -0.045em; margin-bottom: 1.55rem; }
  h2 { font-size: clamp(2.3rem, 4vw, 4.25rem); letter-spacing: -0.035em; margin-bottom: 1.3rem; }
  h3 { font-size: 1.45rem; margin-bottom: 0.7rem; }
  em { color: var(--copper-light); font-weight: 500; }
  .shell { width: min(1160px, calc(100% - 40px)); margin-inline: auto; }
  .skip-link { position: fixed; left: 16px; top: -80px; z-index: 100; background: white; padding: 10px 16px; }
  .skip-link:focus { top: 12px; }

  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    color: white;
    border-bottom: 1px solid rgba(255,255,255,.13);
  }
  .header-inner { min-height: 92px; display: flex; align-items: center; gap: 34px; }
  .brand { display: inline-grid; grid-template-columns: auto 1px auto; align-items: center; gap: 12px; text-decoration: none; line-height: 1; }
  .brand-name { font-family: "Playfair Display", Georgia, serif; font-weight: 600; font-size: 1.8rem; letter-spacing: .04em; }
  .brand-rule { width: 1px; height: 32px; background: var(--copper-light); }
  .brand-sub { font-size: .68rem; letter-spacing: .28em; font-weight: 600; }
  .desktop-nav { margin-left: auto; display: flex; gap: 28px; align-items: center; }
  .desktop-nav a { font-size: .76rem; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; font-weight: 600; opacity: .82; }
  .desktop-nav a:hover { opacity: 1; color: var(--copper-light); }
  .button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 54px;
    padding: 14px 24px;
    border: 1px solid var(--copper);
    border-radius: 2px;
    color: white;
    background: var(--copper);
    box-shadow: 0 12px 34px rgba(199, 125, 87, .22);
    font: 700 .76rem/1.35 "Montserrat", sans-serif;
    letter-spacing: .055em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform .2s ease, background .2s ease, border-color .2s ease;
  }
  .button:hover { transform: translateY(-2px); background: var(--copper-light); border-color: var(--copper-light); }
  .button:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid #f2bd9f; outline-offset: 4px; }
  .button-small { min-height: 44px; padding: 11px 17px; font-size: .65rem; max-width: 260px; }
  .mobile-menu { display: none; margin-left: auto; position: relative; }
  .mobile-menu summary { list-style: none; width: 42px; height: 42px; border: 1px solid rgba(255,255,255,.25); display: grid; place-content: center; gap: 5px; cursor: pointer; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span { display: block; width: 20px; height: 1px; background: white; }
  .mobile-menu nav { position: absolute; right: 0; top: 52px; width: min(310px, calc(100vw - 40px)); background: var(--navy-dark); padding: 20px; box-shadow: var(--shadow); display: grid; gap: 14px; }
  .mobile-menu nav > a:not(.button) { text-decoration: none; font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; padding: 5px; }

  .hero { min-height: 820px; position: relative; overflow: hidden; color: rgba(255,255,255,.82); background: linear-gradient(128deg, var(--navy-dark) 0%, var(--navy) 56%, #173b55 100%); padding-top: 92px; }
  .hero::before { content: ""; position: absolute; inset: 0; opacity: .22; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 58px 58px; mask-image: linear-gradient(to right, black, transparent 76%); }
  .hero-glow { position: absolute; width: 560px; height: 560px; border-radius: 50%; right: -170px; top: 80px; background: rgba(199,125,87,.11); filter: blur(2px); }
  .hero-grid { position: relative; min-height: 645px; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 36px; padding-block: 62px 44px; }
  .hero-copy { position: relative; z-index: 3; max-width: 690px; }
  .hero h1 { color: white; }
  .eyebrow { display: flex; align-items: center; gap: 11px; color: var(--copper); font: 700 .68rem/1.3 "Montserrat", sans-serif; letter-spacing: .21em; margin-bottom: 1.45rem; }
  .eyebrow.light { color: var(--copper-light); }
  .eyebrow i, .footer-tag i { display: inline-block; width: 3px; height: 3px; border-radius: 50%; background: currentColor; }
  .hero-intro { max-width: 640px; font-size: 1.05rem; line-height: 1.75; }
  .hero-price { border-left: 2px solid var(--copper); padding-left: 16px; max-width: 550px; font-size: .92rem; }
  .hero-price strong { color: white; }
  .hero-actions { display: flex; align-items: center; gap: 25px; margin-top: 28px; }
  .text-link { color: white; font-size: .77rem; text-transform: uppercase; text-decoration: none; letter-spacing: .07em; font-weight: 600; white-space: nowrap; }
  .text-link span { color: var(--copper-light); margin-left: 7px; }
  .reassurance { margin: 18px 0 0; font-size: .72rem; letter-spacing: .04em; opacity: .7; }
  .reassurance span { color: var(--copper-light); margin-right: 6px; }

  .showcase { position: relative; min-height: 520px; transform: translateX(15px); }
  .browser-card { position: absolute; width: 500px; height: 345px; top: 70px; left: 5px; border: 7px solid rgba(255,255,255,.92); border-radius: 12px; overflow: hidden; background: white; box-shadow: 0 38px 90px rgba(0,0,0,.36); transform: perspective(1000px) rotateY(-5deg) rotateZ(1deg); }
  .browser-bar { height: 23px; background: #eef0f1; display: flex; align-items: center; gap: 4px; padding-left: 9px; }
  .browser-bar span { width: 5px; height: 5px; border-radius: 50%; background: #c3c8ca; }
  .sample-site { height: calc(100% - 23px); background: #faf6ef; }
  .sample-nav { height: 55px; display: flex; align-items: center; padding: 0 28px; color: #214153; }
  .sample-mark, .phone-mark { font: 500 .55rem/1.05 "Playfair Display", serif; letter-spacing: .1em; }
  .sample-mark b, .phone-mark b { font-size: .46rem; color: var(--copper); }
  .sample-links { margin-left: auto; display: flex; gap: 14px; }
  .sample-links i { width: 32px; height: 2px; background: #d5c9bd; }
  .sample-hero { height: 190px; color: white; padding: 35px 40px; background: linear-gradient(100deg, rgba(16,42,63,.97), rgba(18,56,77,.78)), radial-gradient(circle at 85% 20%, #caa78f, #25485c 50%, #112e42); }
  .sample-hero p, .phone-screen p { font: 600 .42rem "Montserrat", sans-serif; color: #dfa17e; letter-spacing: .25em; margin-bottom: 10px; }
  .sample-hero h2 { font-size: 1.65rem; color: white; margin: 0 0 16px; letter-spacing: -.02em; }
  .sample-hero span, .phone-screen span { display: inline-block; font: 600 .42rem "Montserrat", sans-serif; text-transform: uppercase; letter-spacing: .08em; background: var(--copper); padding: 7px 12px; }
  .sample-cards { display: flex; gap: 10px; padding: 18px 28px; }
  .sample-cards i { height: 54px; flex: 1; background: linear-gradient(135deg, #e8ded1, #c9b39f); }
  .phone-card { position: absolute; z-index: 2; width: 155px; height: 315px; right: -20px; top: 190px; border: 7px solid #eef0ef; border-radius: 24px; background: #111b23; padding: 7px; box-shadow: 0 30px 70px rgba(0,0,0,.4); transform: rotate(3deg); }
  .phone-speaker { position: absolute; z-index: 3; top: 7px; left: 50%; transform: translateX(-50%); width: 45px; height: 5px; border-radius: 5px; background: #071016; }
  .phone-screen { height: 100%; border-radius: 14px; padding: 27px 14px 15px; background: linear-gradient(to bottom, #faf4e9 0 22%, transparent 22%), linear-gradient(155deg, rgba(12,38,56,.84), rgba(24,60,78,.7)), radial-gradient(circle at 60% 75%, #c38a6b, #15374c 55%); color: white; }
  .phone-mark { color: var(--navy); margin-bottom: 72px; }
  .phone-screen h3 { color: white; font-size: 1.25rem; margin-bottom: 15px; }
  .proof-card { position: absolute; z-index: 4; bottom: 14px; left: -20px; display: flex; align-items: center; gap: 12px; background: white; color: var(--navy); padding: 12px 20px; box-shadow: 0 18px 50px rgba(0,0,0,.27); font-family: "Playfair Display", serif; }
  .proof-card small { display: block; color: var(--muted); font: 600 .48rem "Montserrat", sans-serif; letter-spacing: .12em; }
  .proof-icon { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 50%; color: white; background: var(--copper); }
  .orbit { position: absolute; border: 1px solid rgba(217,148,109,.27); border-radius: 50%; }
  .orbit-one { width: 520px; height: 520px; right: -120px; top: 10px; }
  .orbit-two { width: 390px; height: 390px; right: -55px; top: 75px; }
  .hero-ribbon { position: relative; border-top: 1px solid rgba(255,255,255,.12); background: rgba(7,27,42,.45); }
  .ribbon-inner { min-height: 82px; display: flex; align-items: center; justify-content: space-between; color: rgba(255,255,255,.58); font-size: .64rem; font-weight: 600; letter-spacing: .14em; }
  .ribbon-inner i { width: 4px; height: 4px; border-radius: 50%; background: var(--copper); }

  .section { padding: 120px 0; }
  .intro-section { background: var(--cream); }
  .split-heading { display: grid; grid-template-columns: 1.25fr .75fr; gap: 80px; align-items: end; margin-bottom: 60px; }
  .split-heading p:last-child { color: var(--muted); max-width: 440px; margin-bottom: 18px; }
  .benefit-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
  .benefit-card { min-height: 285px; padding: 34px 30px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); position: relative; background: rgba(255,255,255,.14); transition: background .2s, transform .2s; }
  .benefit-card:hover { background: rgba(255,255,255,.46); transform: translateY(-3px); }
  .benefit-number { position: absolute; right: 20px; top: 18px; font-size: .58rem; color: #9a9f9e; letter-spacing: .12em; }
  .benefit-icon { width: 42px; height: 42px; margin-bottom: 23px; display: grid; place-items: center; border: 1px solid rgba(199,125,87,.5); transform: rotate(45deg); }
  .benefit-icon span { width: 10px; height: 10px; background: var(--copper); }
  .benefit-card p { color: var(--muted); font-size: .88rem; line-height: 1.72; margin-bottom: 0; }
  .concept-band { margin-top: 65px; padding: 44px 48px; display: flex; align-items: center; justify-content: space-between; gap: 30px; color: white; background: var(--navy); box-shadow: var(--shadow); }
  .concept-band h2 { color: white; font-size: clamp(1.8rem, 3vw, 2.7rem); margin-bottom: 0; }
  .concept-band .eyebrow { margin-bottom: 9px; }

  .process-section { background: #fffaf3; }
  .process-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 100px; align-items: start; }
  .process-copy { position: sticky; top: 40px; }
  .process-copy > p:last-child { color: var(--muted); max-width: 460px; }
  .steps { list-style: none; padding: 0; margin: 0; }
  .steps li { display: grid; grid-template-columns: 62px 1fr; gap: 26px; padding: 5px 0 32px; margin-bottom: 27px; border-bottom: 1px solid var(--line); }
